package site

import (
	"github.com/riadafridishibly/quickstack/internal/media"
	"github.com/riadafridishibly/quickstack/internal/platform"
	"github.com/riadafridishibly/quickstack/internal/web"
)

templ sitePage(v pageView) {
	@platform.Layout("Site") {
		@web.PageHeader("Site")
		@web.Flash(v.Message)
		<section class={ web.PaddedCardClass, "max-w-3xl" }>
			<h2 class="text-lg font-semibold">Icon</h2>
			<p class="mt-1 text-sm opacity-70">
				Shown in browser tabs and bookmarks, on phone home screens, and when the site is installed as an app.
				Use a square image: a PNG or JPEG at least { media.IconMinSize } pixels on each side, or an SVG.
			</p>
			@iconStatus(v)
			@iconFormEl(v)
		</section>
	}
}

// iconStatus shows the chosen icon. While its files are being drawn it
// asks again every two seconds.
templ iconStatus(v pageView) {
	<div
		id={ statusTarget }
		if v.drawing() {
			hx-get={ adminPath }
			hx-trigger="every 2s"
			hx-swap="outerHTML"
		}
		class="mt-5 flex items-center gap-4"
	>
		if a := v.Icon; a != nil {
			if src := media.Thumb(a.Key, a.ContentType, a.Widths); src != "" {
				<img src={ src } alt="" class="size-16 shrink-0 rounded bg-base-200 object-contain"/>
			}
			<div class="min-w-0 text-sm">
				<p class="font-mono">{ media.URL(a.Key) }</p>
				if v.drawing() {
					<p class="opacity-70">Drawing the icon’s files. Pages show the previous icon until they’re ready.</p>
				} else {
					<p class="opacity-70">Pages show this icon.</p>
				}
			</div>
		} else {
			<p class="text-sm opacity-70">No icon is set, so browsers show their own.</p>
		}
	</div>
}

templ iconFormEl(v pageView) {
	{{ f := v.Form }}
	<form
		id={ iconTarget }
		method="post"
		action={ templ.SafeURL(iconPath) }
		hx-post={ iconPath }
		hx-swap="outerHTML"
		novalidate
		class="mt-6 space-y-5"
	>
		if len(f.Errors) > 0 {
			<p role="alert" class="alert alert-error alert-soft">The icon wasn’t saved. Fix the fields marked below.</p>
		}
		@web.Field("Image", "icon", f.Errors["icon"]) {
			<input type="text" { web.InputAttrs("icon", f.Errors["icon"])... } value={ f.Icon } placeholder="/media/ab12cd34" class={ web.InputClass, "font-mono text-sm" }/>
		}
		<p class="-mt-3 text-sm opacity-70">
			An image’s address from <a href="/admin/media" class={ web.LinkClass }>Media</a>. Leave it empty to remove the icon.
		</p>
		@web.Field("Background", "background", f.Errors["background"]) {
			<input type="color" { web.InputAttrs("background", f.Errors["background"])... } value={ f.Background } class="h-10 w-16 cursor-pointer rounded-field border border-base-300 bg-base-100 p-1"/>
		}
		<p class="-mt-3 text-sm opacity-70">
			Fills the transparent parts of the icon on iPhone and iPad home screens, which would otherwise be black. An installed app also uses it for its title bar.
		</p>
		<button type="submit" class={ web.ButtonClass }>Save</button>
	</form>
}
