package auth

import (
	"net/url"
	"strconv"

	"github.com/riadafridishibly/quickstack/internal/web"
)

type loginView struct {
	Email string
	Next  string
	Error string
}

templ loginPage(v loginView) {
	@web.Layout("Sign in") {
		<div class="mx-auto max-w-sm">
			<h1 class="mb-6 text-2xl font-semibold tracking-tight">Sign in</h1>
			<form method="post" action={ templ.SafeURL(LoginPath) } class={ web.PaddedCardClass, "space-y-5" }>
				if v.Error != "" {
					<p role="alert" class="alert alert-error alert-soft">{ v.Error }</p>
				}
				<input type="hidden" name="next" value={ v.Next }/>
				@web.Field("Email", "email", "") {
					<input type="email" { web.InputAttrs("email", "")... } value={ v.Email } autocomplete="username" required autofocus class={ web.InputClass }/>
				}
				@web.Field("Password", "password", "") {
					<input type="password" { web.InputAttrs("password", "")... } autocomplete="current-password" required class={ web.InputClass }/>
				}
				<button type="submit" class={ web.ButtonClass, "w-full" }>Sign in</button>
				<p class="text-center text-sm">
					<a href={ templ.SafeURL(forgotPath + "?email=" + url.QueryEscape(v.Email)) } class={ web.LinkClass }>Forgot your password?</a>
				</p>
			</form>
			<p class="mt-6 text-center text-sm opacity-80">
				New here? <a href={ templ.SafeURL(SignupPath + "?next=" + url.QueryEscape(v.Next)) } class={ web.LinkClass }>Create an account</a>
			</p>
		</div>
	}
}

type signupView struct {
	Name   string
	Email  string
	Next   string
	Error  string
	Errors map[string]string
}

templ signupPage(v signupView) {
	@web.Layout("Create an account") {
		<div class="mx-auto max-w-sm">
			<h1 class="mb-6 text-2xl font-semibold tracking-tight">Create an account</h1>
			<form method="post" action={ templ.SafeURL(SignupPath) } novalidate class={ web.PaddedCardClass, "space-y-5" }>
				if v.Error != "" {
					<p role="alert" class="alert alert-error alert-soft">{ v.Error }</p>
				}
				<input type="hidden" name="next" value={ v.Next }/>
				@web.Field("Your name", "name", v.Errors["name"]) {
					<input type="text" { web.InputAttrs("name", v.Errors["name"])... } value={ v.Name } autocomplete="name" required autofocus class={ web.InputClass }/>
				}
				@web.Field("Email", "email", v.Errors["email"]) {
					<input type="email" { web.InputAttrs("email", v.Errors["email"])... } value={ v.Email } autocomplete="username" required class={ web.InputClass }/>
				}
				@web.Field("Password", "password", v.Errors["password"]) {
					<input type="password" { web.InputAttrs("password", v.Errors["password"])... } autocomplete="new-password" required minlength="10" class={ web.InputClass }/>
				}
				<button type="submit" class={ web.ButtonClass, "w-full" }>Create account</button>
			</form>
			<p class="mt-6 text-center text-sm opacity-80">
				Have an account? <a href={ templ.SafeURL(LoginPath + "?next=" + url.QueryEscape(v.Next)) } class={ web.LinkClass }>Sign in</a>
			</p>
		</div>
	}
}

type forgotView struct {
	Email string
	Error string
}

templ forgotPage(v forgotView) {
	@web.Layout("Reset your password") {
		<div class="mx-auto max-w-sm">
			<h1 class="mb-6 text-2xl font-semibold tracking-tight">Reset your password</h1>
			<form method="post" action={ templ.SafeURL(forgotPath) } novalidate class={ web.PaddedCardClass, "space-y-5" }>
				<p class="text-sm opacity-80">Enter your account’s email, and we’ll send you a link to choose a new password.</p>
				if v.Error != "" {
					<p role="alert" class="alert alert-error alert-soft">{ v.Error }</p>
				}
				@web.Field("Email", "email", "") {
					<input type="email" { web.InputAttrs("email", "")... } value={ v.Email } autocomplete="username" required autofocus class={ web.InputClass }/>
				}
				<button type="submit" class={ web.ButtonClass, "w-full" }>Send reset link</button>
			</form>
		</div>
	}
}

templ forgotSentPage(email string) {
	@web.Layout("Check your email") {
		<div class="mx-auto max-w-sm">
			<h1 class="mb-6 text-2xl font-semibold tracking-tight">Check your email</h1>
			<div class={ web.PaddedCardClass, "space-y-3 text-sm" }>
				<p>If <strong>{ email }</strong> has an account, we sent it a link to reset the password. The link works for an hour.</p>
				<p><a href={ templ.SafeURL(LoginPath) } class={ web.LinkClass }>Back to sign in</a></p>
			</div>
		</div>
	}
}

type resetView struct {
	Token  string
	Errors map[string]string
}

templ resetPage(v resetView) {
	@web.Layout("Choose a new password") {
		<div class="mx-auto max-w-sm">
			<h1 class="mb-6 text-2xl font-semibold tracking-tight">Choose a new password</h1>
			<form method="post" action={ templ.SafeURL(resetPath) } novalidate class={ web.PaddedCardClass, "space-y-5" }>
				<input type="hidden" name="token" value={ v.Token }/>
				@web.Field("New password", "password", v.Errors["password"]) {
					<input type="password" { web.InputAttrs("password", v.Errors["password"])... } autocomplete="new-password" required minlength="10" autofocus class={ web.InputClass }/>
				}
				@web.Field("Confirm new password", "confirm_password", v.Errors["confirm_password"]) {
					<input type="password" { web.InputAttrs("confirm_password", v.Errors["confirm_password"])... } autocomplete="new-password" required class={ web.InputClass }/>
				}
				<button type="submit" class={ web.ButtonClass, "w-full" }>Set password and sign in</button>
			</form>
		</div>
	}
}

templ resetExpiredPage() {
	@web.Layout("Link expired") {
		<div class="mx-auto max-w-sm">
			<h1 class="mb-6 text-2xl font-semibold tracking-tight">This link has expired</h1>
			<div class={ web.PaddedCardClass, "space-y-3 text-sm" }>
				<p>Reset links work once, for an hour.</p>
				<p><a href={ templ.SafeURL(forgotPath) } class={ web.LinkClass }>Send a new link</a></p>
			</div>
		</div>
	}
}

templ verifyEmailPage(token, email string) {
	@web.Layout("Verify your email") {
		<div class="mx-auto max-w-sm">
			<h1 class="mb-6 text-2xl font-semibold tracking-tight">Verify your email</h1>
			<form method="post" action={ templ.SafeURL(verifyEmailPath) } class={ web.PaddedCardClass, "space-y-5" }>
				<p class="text-sm">Confirm that <strong class="break-all">{ email }</strong> is your address.</p>
				<input type="hidden" name="token" value={ token }/>
				<button type="submit" class={ web.ButtonClass, "w-full" }>Verify email</button>
			</form>
		</div>
	}
}

templ emailVerifiedPage() {
	@web.Layout("Email verified") {
		<div class="mx-auto max-w-sm">
			<h1 class="mb-6 text-2xl font-semibold tracking-tight">Email verified</h1>
			<div class={ web.PaddedCardClass, "space-y-3 text-sm" }>
				<p>Thanks. Your email address is verified.</p>
				<p><a href={ templ.SafeURL(HomePath) } class={ web.LinkClass }>Continue</a></p>
			</div>
		</div>
	}
}

templ verifyExpiredPage() {
	@web.Layout("Link expired") {
		<div class="mx-auto max-w-sm">
			<h1 class="mb-6 text-2xl font-semibold tracking-tight">This link has expired</h1>
			<div class={ web.PaddedCardClass, "space-y-3 text-sm" }>
				<p>Verification links work once, for three days. Sign in to send a new one from your profile.</p>
				<p><a href={ templ.SafeURL(HomePath) } class={ web.LinkClass }>Sign in</a></p>
			</div>
		</div>
	}
}

type challengeView struct {
	Factors []Factor
	// Failed names the factor whose Verify failed, which shows Error.
	Failed string
	Error  string
}

templ challengePage(v challengeView) {
	@web.Layout("Verify it’s you") {
		<div class="mx-auto max-w-sm">
			<h1 class="mb-6 text-2xl font-semibold tracking-tight">Verify it’s you</h1>
			@factorForms(challengePath, "", v.Factors, v.Failed, v.Error)
			<p class="mt-6 text-center text-sm opacity-80">
				<a href={ templ.SafeURL(LoginPath) } class={ web.LinkClass }>Start over</a>
			</p>
		</div>
	}
}

// factorForms renders a form for each factor, posting to action. The one
// named failed shows errMsg.
templ factorForms(action, next string, fs []Factor, failed, errMsg string) {
	<div class="space-y-4">
		for i, f := range fs {
			if i > 0 {
				<p class="text-center text-sm opacity-70">or</p>
			}
			<form method="post" action={ templ.SafeURL(action) } novalidate class={ web.PaddedCardClass, "space-y-5" }>
				<input type="hidden" name="factor" value={ f.Name() }/>
				if next != "" {
					<input type="hidden" name="next" value={ next }/>
				}
				if f.Name() == failed {
					@f.Form(errMsg)
				} else {
					@f.Form("")
				}
			</form>
		}
	</div>
}

templ confirmPage(v confirmView) {
	@web.Layout("Confirm it’s you") {
		<div class="mx-auto max-w-sm">
			<h1 class="mb-6 text-2xl font-semibold tracking-tight">Confirm it’s you</h1>
			if len(v.Factors) > 0 {
				@factorForms(ConfirmPath, v.Next, v.Factors, v.Failed, v.Error)
			} else if v.HasPassword {
				<form method="post" action={ templ.SafeURL(ConfirmPath) } novalidate class={ web.PaddedCardClass, "space-y-5" }>
					<p class="text-sm opacity-80">Enter your password to continue.</p>
					<input type="hidden" name="next" value={ v.Next }/>
					@web.Field("Password", "password", v.Error) {
						<input type="password" { web.InputAttrs("password", v.Error)... } autocomplete="current-password" required autofocus class={ web.InputClass }/>
					}
					<button type="submit" class={ web.ButtonClass, "w-full" }>Continue</button>
				</form>
			}
			<form method="post" action={ templ.SafeURL(LogoutPath) } class="mt-6 text-center text-sm opacity-80">
				Or <button type="submit" class={ web.LinkClass }>sign out</button> and sign in again.
			</form>
		</div>
	}
}

templ recoveryForm(errMsg string) {
	<details open?={ errMsg != "" } class="group">
		<summary class="cursor-pointer text-sm font-medium">Use a recovery code</summary>
		<div class="mt-4 space-y-5">
			@web.Field("Recovery code", "recovery_code", errMsg) {
				<input type="text" { web.InputAttrs("recovery_code", errMsg)... } autocomplete="off" autocapitalize="off" spellcheck="false" required class={ web.InputClass, "font-mono" }/>
			}
			<button type="submit" class={ web.SecondaryButtonClass, "w-full" }>Use code</button>
		</div>
	</details>
}

templ recoverySection(left int) {
	<section class={ web.PaddedCardClass }>
		<h2 class="text-lg font-semibold">Recovery codes</h2>
		<p class="mt-1 text-sm opacity-70">Each code signs you in once if you can’t use your second factor, such as after losing your phone.</p>
		<p class={ "mt-3 text-sm", templ.KV("text-warning", left <= 3) }>
			{ strconv.Itoa(left) } of { strconv.Itoa(recoveryCodeCount) } codes left.
		</p>
		<form method="post" action={ templ.SafeURL(recoveryPath) } class="mt-4">
			<button type="submit" class={ web.SecondaryButtonClass }>Make new codes</button>
		</form>
	</section>
}

// recoveryCodesPage shows new recovery codes, the only time they are shown.
templ recoveryCodesPage(layout func(string) templ.Component, notice string, codes []string) {
	@layout("Recovery codes") {
		@web.PageHeader("Save your recovery codes")
		<div class={ web.PaddedCardClass, "max-w-xl space-y-5" }>
			if notice != "" {
				<p role="status" class="alert alert-success alert-soft">{ notice }</p>
			}
			<p class="text-sm">If you can’t use your second factor, each of these codes signs you in once. Keep them in a password manager or print them: this is the only time they’re shown, and the codes you had before no longer work.</p>
			<ul id="recovery-codes" class="grid grid-cols-2 gap-x-6 gap-y-2 rounded-box bg-base-200 p-4 font-mono">
				for _, c := range codes {
					<li>{ c }</li>
				}
			</ul>
			<a href={ templ.SafeURL(SecurityPath) } class={ web.ButtonClass }>I’ve saved them</a>
		</div>
	}
}
