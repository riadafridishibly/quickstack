package insights

import (
	"strconv"

	"github.com/riadafridishibly/quickstack/internal/auth"
	"github.com/riadafridishibly/quickstack/internal/chart"
	"github.com/riadafridishibly/quickstack/internal/db"
	"github.com/riadafridishibly/quickstack/internal/tenant"
	"github.com/riadafridishibly/quickstack/internal/web"
	"github.com/riadafridishibly/quickstack/internal/workspaces"
)

templ overviewPage(v overviewView) {
	{{ ws := tenant.From(ctx) }}
	@workspaces.Layout(ws.Name) {
		@web.PageHeader(ws.Name)
		<div class="grid grid-cols-2 gap-4 lg:grid-cols-4">
			@web.StatTile("To do", web.Count(v.Counts.Todo), "In active projects")
			@web.StatTile("In progress", web.Count(v.Counts.Doing), "")
			@web.StatTile("Done this week", web.Count(v.Counts.DoneThisWeek), "Last 7 days")
			@web.StatTile("Overdue", web.Count(v.Counts.Overdue), "Past their due date")
		</div>
		<div class="mt-6 grid gap-6 lg:grid-cols-[2fr_1fr]">
			@flowSection(v)
			@assignedCard(v.Assigned)
		</div>
		<section class={ web.PaddedCardClass, "mt-6" }>
			<h2 class="font-semibold">Assigned to you</h2>
			if len(v.Mine) == 0 {
				<p class="mt-2 text-sm opacity-70">Nothing open is assigned to you.</p>
			} else {
				<ul class="mt-3 divide-y divide-base-300">
					for _, t := range v.Mine {
						<li class="flex flex-wrap items-baseline justify-between gap-2 py-2">
							<a href={ templ.SafeURL(ws.URL("/projects/" + strconv.FormatInt(t.ProjectID, 10))) } class="min-w-0">
								<span class="font-medium link-hover">{ t.Title }</span>
								<span class="text-sm opacity-60">· { t.ProjectName }</span>
							</a>
							if t.DueOn != nil {
								<span class="text-sm tabular-nums opacity-70">Due { t.DueOn.Format("Jan 2") }</span>
							}
						</li>
					}
				</ul>
			}
		</section>
		if auth.CanIn(ctx, auth.ManageProjects) {
			<p class="mt-6 text-sm opacity-70">
				Start something new: <a href={ templ.SafeURL(ws.URL("/projects/new")) } class={ web.LinkClass }>create a project</a>.
			</p>
		}
	}
}

// flowSection is the chart with its range tabs. Choosing a range swaps in
// just this section.
templ flowSection(v overviewView) {
	{{ ws := tenant.From(ctx) }}
	<div id={ flowTarget } class="min-w-0 space-y-2 transition-opacity [&.htmx-request]:opacity-60">
		<nav aria-label="Range" class="join">
			for _, d := range ranges {
				{{ href := ws.URL("?days=" + strconv.Itoa(d)) }}
				<a
					href={ templ.SafeURL(href) }
					hx-get={ href }
					hx-target={ "#" + flowTarget }
					hx-swap="outerHTML"
					hx-push-url="true"
					class={ "btn btn-sm join-item", templ.KV("btn-active", d == v.Days) }
					if d == v.Days {
						aria-current="page"
					}
				>{ strconv.Itoa(d) } days</a>
			}
		</nav>
		@chart.Card(v.Flow)
	</div>
}

templ assignedCard(rows []db.OpenTasksByAssigneeRow) {
	<section class={ web.PaddedCardClass, "min-w-0" }>
		<h2 class="font-semibold">Open tasks by assignee</h2>
		if len(rows) == 0 {
			<p class="mt-2 text-sm opacity-70">No open tasks.</p>
		} else {
			<ul class="mt-4 space-y-3">
				for _, r := range rows {
					<li>
						<div class="flex justify-between gap-2 text-sm">
							if r.Name == "" {
								<span class="italic opacity-70">Unassigned</span>
							} else {
								<span class="truncate">{ r.Name }</span>
							}
							<span class="tabular-nums">{ web.Count(r.Open) }</span>
						</div>
						<svg class="mt-1 h-2 w-full" aria-hidden="true">
							<rect width="100%" height="8" rx="4" class="fill-base-300"></rect>
							<rect width={ chart.BarWidth(r.Open, rows[0].Open) } height="8" rx="4" class="fill-chart-1"></rect>
						</svg>
					</li>
				}
			</ul>
		}
	</section>
}
